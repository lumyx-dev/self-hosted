# Domains pointing at this server. Caddy gets Let's Encrypt certificates for both.
# Local test: DASHBOARD_DOMAIN=localhost and SFU_DOMAIN=sfu.localhost (self-signed).
DASHBOARD_DOMAIN=dashboard.example.com
SFU_DOMAIN=sfu.example.com

# Public IP advertised to browsers in ICE candidates. Local test: 127.0.0.1.
PUBLIC_IP=203.0.113.10

# Media ports, one per connected peer: the range caps concurrent participants.
UDP_PORT_MIN=40000
UDP_PORT_MAX=40099

# Image versions (tags of lumyx-dev/dashboard and lumyx-dev/sfu-core).
DASHBOARD_VERSION=0.1.0
SFU_VERSION=0.1.0

SFU_REGION=local
SFU_LOG=info
